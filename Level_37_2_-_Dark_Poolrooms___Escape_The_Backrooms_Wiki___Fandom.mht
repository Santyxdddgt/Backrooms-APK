.toc.ready { display: block; }

.toc.closed { align-items: center; border: 0px; border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 12px 0px; display: flex; height: 60px; justify-content: flex-start; left: auto; padding-left: 14px; right: -20px; transition: right 0.3s ease 0s; width: 60px; }

.toc.closed .toctitle { border-bottom: 0px; margin: 0px; }

.toc.closed .toctitle .toc-close, .toc.closed .toctitle h2, .toc.closed > ul { display: none; }

.toc .toctogglecheckbox:checked ~ ul { display: block; }

.toc .toctitle { align-items: center; border-bottom: 1px solid var(--theme-border-color); display: flex; margin: 0px 12px 6px; text-align: left; }

.toc .toctitle h2 { flex: 1 1 0%; font-size: 16px; margin: 0px; }

.toc:not(.closed) .toc-icon { fill: var(--theme-page-text-color); }

.toc-icon { margin-right: 6px; }

body:not(.fandommobile-fandom-theme) .toc-icon { fill: var(--theme-link-color); }

.toc-close { align-items: center; color: var(--fandommobile-toc-close-icon-color); display: flex; height: 44px; justify-content: center; margin-right: -12px; width: 44px; }

.toctogglespan { display: none; }

@media (max-width: 639px) {
  table.infobox, table.pi-horizontal-group { display: table; }
}

.recirculation-prefooter { padding: 0px 0.75rem 1.125rem; }

.recirculation-prefooter__header { padding: 0.375rem 0px 0.75rem; text-align: center; }

.recirculation-prefooter__item { border-radius: 3px; height: 259px; margin-bottom: 12px; overflow-y: hidden; position: relative; }

.recirculation-prefooter__item-thumbnail { width: 100%; }

.recirculation-prefooter__item-anchor { color: rgb(255, 255, 255); display: flex; flex-direction: column; height: 100%; justify-content: flex-end; position: relative; z-index: 1; }

.recirculation-prefooter__item-anchor.has-thumbnail { background-image: linear-gradient(rgba(0, 0, 0, 0), rgb(0, 0, 0)); position: absolute; top: 0px; width: 100%; }

.recirculation-prefooter__placeholder { align-items: center; background-color: rgb(30, 12, 27); display: flex; height: 100%; justify-content: center; left: 0px; position: absolute; top: 0px; width: 100%; }

.recirculation-prefooter__placeholder svg { height: 25%; }

.recirculation-prefooter__badge-sponsored { background-color: rgb(131, 141, 134); color: rgb(255, 255, 255); left: 0px; padding: 3px 8px; position: absolute; top: 0px; }

.recirculation-prefooter__list { list-style: none; margin: 0px; }

.recirculation-prefooter__title { color: rgb(255, 255, 255); margin-bottom: 6px; padding: 0px 16px; }

.recirculation-prefooter__subtitle { color: rgb(255, 255, 255); margin-bottom: 13px; opacity: 0.5; padding-left: 16px; }

.recirculation-prefooter__personalization { color: rgb(255, 197, 0); margin-bottom: 6px; padding: 0px 16px; }

.recirculation-prefooter__wiki-articles { background-color: var(--theme-page-background-color--secondary); border: 1px solid var(--theme-border-color); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.1) 0px 6px 10px 0px; margin-bottom: 0.75rem; width: 100%; }

.recirculation-prefooter__wiki-articles-header { background-color: var(--theme-page-text-color); border-top-left-radius: 3px; border-top-right-radius: 3px; color: var(--theme-page-background-color--secondary); padding: 16px; text-align: center; }

.recirculation-prefooter__wiki-articles-list { list-style: none; margin: 0px; padding: 0px 18px; }

.recirculation-prefooter__wiki-article:not(:last-child) { border-bottom: 1px solid var(--theme-border-color); }

.recirculation-prefooter__wiki-article-anchor { align-items: center; color: inherit; display: flex; height: 80px; }

.recirculation-prefooter__wiki-article-circle { align-items: center; background-color: var(--theme-border-color); border-radius: 50%; color: var(--theme-page-text-color); display: flex; height: 36px; justify-content: center; min-width: 36px; width: 36px; }

.recirculation-prefooter__wiki-article-title { margin-left: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.notifications-box { bottom: var(--fandom-ad-sticky-placement-bottom-offset,0); position: sticky; transition: bottom 0.2s ease 0s; width: 100%; z-index: 300; }

html.cookie-banner-api-usp .notifications-box { transition: bottom 0.2s ease 0.4s; }

html.cookie-banner-visible.cookie-banner-api-usp .notifications-box { bottom: calc(var(--cookie-banner-height,0) + var(--fandom-ad-sticky-placement-bottom-offset,0)); }


.skin-fandommobile:not(.fandommobile-fandom-theme) .article-table-wrapper table th { background-color: var(--theme-page-background-color--secondary); color: inherit; text-align: left; }

.skin-fandommobile:not(.fandommobile-fandom-theme) .article-table-wrapper table tr > td { font-size: 14px; line-height: 1.5; }

.skin-fandommobile:not(.fandommobile-fandom-theme) .wds-pill { --wds-pill-background-color: var(--theme-page-background-color--secondary); --wds-pill-border-color: var(--theme-border-color); --wds-pill-label-color: var(--theme-page-text-color); --wds-pill-background-color--active: var(--theme-accent-color); --wds-pill-border-color--active: var(--theme-accent-color--hover); --wds-pill-label-color--active: var(--theme-accent-label-color); }

.skin-fandommobile:not(.fandommobile-fandom-theme) .sitenotice-wrapper__read-more { background-color: var(--theme-page-background-color--secondary); }

.skin-fandommobile:not(.fandommobile-fandom-theme) .sitenotice-wrapper__content a { color: var(--theme-link-color); }

.skin-fandommobile:not(.fandommobile-fandom-theme) .sitenotice-wrapper__content a:hover { color: var(--theme-link-color--hover); }

.skin-fandommobile:not(.fandommobile-fandom-theme) .sitenotice-wrapper__read-more--visible::before { background: linear-gradient(to bottom,rgba(var(--theme-page-background-color--secondary--rgb),0) 0,var(--theme-page-background-color--secondary) 100%); }

